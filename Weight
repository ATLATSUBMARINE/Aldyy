        // ================= Koneksi =================
        void RefreshPorts()
        {
            cmbPort.Items.Clear();
            cmbPort.Items.AddRange(SerialPort.GetPortNames());
            if (cmbPort.Items.Count > 0) cmbPort.SelectedIndex = 0;
        }

        void BtnConnect_Click(object s, EventArgs e)
        {
            if (chkSim.Checked)
            {
                simTimer.Start();
                SetStatus("● SIMULASI (data bukan dari timbangan asli)", Color.DarkOrange);
            }
            else
            {
                if (cmbPort.SelectedItem == null) { MessageBox.Show("Pilih COM port dulu."); return; }
                try
                {
                    // 8N1 = default umum; SESUAIKAN dengan manual CAS EC-D
                    sp = new SerialPort(cmbPort.SelectedItem.ToString(), int.Parse(cmbBaud.SelectedItem.ToString()), Parity.None, 8, StopBits.One);
                    sp.DataReceived += Sp_DataReceived;
                    sp.Open();
                    SetStatus("● CONNECTED " + sp.PortName, Color.Green);
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Gagal konek: " + ex.Message);
                    SetStatus("● ERROR", Color.Red);
                    return;
                }
            }
            btnConnect.Enabled = false;
            btnDisconnect.Enabled = true;
            chkSim.Enabled = false;
        }

        void Disconnect()
        {
            simTimer.Stop();
            try
            {
                if (sp != null)
                {
                    sp.DataReceived -= Sp_DataReceived;
                    if (sp.IsOpen) sp.Close();
                    sp.Dispose();
                    sp = null;
                }
            }
            catch { }
            SetStatus("● DISCONNECTED", Color.Red);
            btnConnect.Enabled = true;
            btnDisconnect.Enabled = false;
            chkSim.Enabled = true;
        }

        void SetStatus(string t, Color c) { lblStatus.Text = t; lblStatus.ForeColor = c; }

        void Sp_DataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            try
            {
                string data = sp.ReadExisting();
                BeginInvoke(new Action(() => OnData(data)));
            }
            catch (Exception ex)
            {
                try { BeginInvoke(new Action(() => SetStatus("● ERROR: " + ex.Message, Color.Red))); } catch { }
            }
        }

        // ================= Parsing =================
        void OnData(string data)
        {
            txtRaw.AppendText(data.Replace("\r", "\\r").Replace("\n", "\\n\r\n"));
            if (txtRaw.TextLength > 4000) txtRaw.Text = txtRaw.Text.Substring(2000);

            buffer.Append(data);
            string all = buffer.ToString();
            int idx;
            while ((idx = all.IndexOfAny(new[] { '\r', '\n' })) >= 0)
            {
                string line = all.Substring(0, idx).Trim();
                all = all.Substring(idx + 1);
                if (line.Length > 0) HandleLine(line);
            }
            buffer.Clear();
            buffer.Append(all);
            if (buffer.Length > 500) buffer.Clear();
        }

        // PARSER GENERIK: ambil angka pertama. SESUAIKAN dengan format asli EC-D.
        void HandleLine(string line)
        {
            var m = Regex.Match(line, @"[-+]?\d+(\.\d+)?");
            if (!m.Success)
            {
                lblStable.Text = "DATA TIDAK VALID";
                lblStable.ForeColor = Color.Red;
                return;
            }
            double w = double.Parse(m.Value, CultureInfo.InvariantCulture);
            string up = line.ToUpperInvariant();
            if (!up.Contains("KG") && Regex.IsMatch(up, @"\d\s*G\b")) w /= 1000.0;
            ProcessWeight(w);
        }

        // ================= Proses berat =================
        void ProcessWeight(double w)
        {
            lblWeight.Text = w.ToString("0.00", CultureInfo.InvariantCulture) + " kg";

            if (w < EmptyThreshold)
            {
                armed = true;
                stableCount = 0;
                lastWeight = double.NaN;
                lblStable.Text = "KOSONG";
                lblStable.ForeColor = Color.Gray;
                if (currentId == null) SetResult("WAITING", Color.Gainsboro, Color.Black);
                return;
            }

            if (!double.IsNaN(lastWeight) && Math.Abs(w - lastWeight) <= 0.005) stableCount++;
            else stableCount = 0;
            lastWeight = w;

            bool stable = stableCount >= StableNeeded;
            lblStable.Text = stable ? "STABLE" : "UNSTABLE";
            lblStable.ForeColor = stable ? Color.Green : Color.DarkOrange;

            if (stable && armed)
            {
                if (currentId == null)
                {
                    SetResult("SCAN ID DULU", Color.Khaki, Color.Black);
                    return;
                }
                armed = false;
                Record(currentId, w);
            }
        }

        void Record(string id, double w)
        {
            if (numLower.Value >= numUpper.Value)
            {
                MessageBox.Show("Lower limit harus lebih kecil dari Upper limit.");
                armed = true;
                return;
            }
            bool ok = (decimal)w >= numLower.Value && (decimal)w <= numUpper.Value;
            string res = ok ? "OK" : "NG";
            if (ok) { okCount++; SetResult("OK", Color.LimeGreen, Color.White); }
            else { ngCount++; SetResult("NG", Color.Red, Color.White); System.Media.SystemSounds.Hand.Play(); }
            lblOk.Text = "OK: " + okCount;
            lblNg.Text = "NG: " + ngCount;
            lblTotal.Text = "Total: " + (okCount + ngCount);

            string time = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            string ws = w.ToString("0.00", CultureInfo.InvariantCulture);
            if (rowsById.TryGetValue(id, out var row))
            {
                int n = int.Parse(row.Cells[4].Value.ToString()) + 1;
                row.SetValues(time, id, ws, res, n);
                dgv.Rows.Remove(row);
                dgv.Rows.Insert(0, row);
            }
            else
            {
                int i = dgv.Rows.Add(time, id, ws, res, 1);
                var r = dgv.Rows[i];
                rowsById[id] = r;
                dgv.Rows.Remove(r);
                dgv.Rows.Insert(0, r);
            }
            rowsById[id].DefaultCellStyle.BackColor = ok ? Color.Honeydew : Color.MistyRose;

            try
            {
                bool newFile = !File.Exists(csvPath);
                using (var sw = new StreamWriter(csvPath, true, Encoding.UTF8))
                {
                    if (newFile) sw.WriteLine("Time,ProductID,Weight_kg,Result,Source");
                    sw.WriteLine($"{time},{id},{ws},{res},{(simTimer.Enabled ? "SIMULATION" : "SCALE")}");
                }
            }
            catch (Exception ex) { MessageBox.Show("Gagal tulis CSV: " + ex.Message); }

            currentId = null;
            lblId.Text = "ID aktif: -";
            txtScan.Focus();
        }

