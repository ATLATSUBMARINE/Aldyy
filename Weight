        void FitFont(Label l, string fam, float maxChars, bool bold)
        {
            if (l.Width < 20 || l.Height < 20) return;
            float byH = l.Height * 0.55f * 0.75f;
            float byW = l.Width / (maxChars * 0.65f) * 0.75f;
            float sz = Math.Max(8f, Math.Min(byH, byW));
            if (Math.Abs(l.Font.Size - sz) < 0.5f) return;
            Font old = l.Font;
            l.Font = new Font(fam, sz, bold ? FontStyle.Bold : FontStyle.Regular);
            old.Dispose();
        }

