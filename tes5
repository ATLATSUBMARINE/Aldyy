        // =========================================================
        // SIMPAN HASIL INSPEKSI
        // =========================================================

        private void RecordInspection(
            string productId,
            double weight)
        {
            if (numLower.Value >= numUpper.Value)
            {
                MessageBox.Show(
                    "Lower limit harus lebih kecil dari Upper limit.",
                    "Limit Tidak Valid",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                readyToRecord = true;
                txtScan.Focus();

                return;
            }

            decimal decimalWeight =
                Convert.ToDecimal(weight);

            bool isOk =
                decimalWeight >= numLower.Value &&
                decimalWeight <= numUpper.Value;

            string result =
                isOk ? "OK" : "NG";

            if (isOk)
            {
                okCount++;

                SetResult(
                    "OK",
                    Color.FromArgb(27, 155, 80),
                    Color.White);
            }
            else
            {
                ngCount++;

                SetResult(
                    "NG",
                    primaryColor,
                    Color.White);

                SystemSounds.Hand.Play();
            }

            lblOk.Text =
                "OK: " + okCount;

            lblNg.Text =
                "NG: " + ngCount;

            lblTotal.Text =
                "TOTAL: " +
                (okCount + ngCount);

            string inspectionTime =
                DateTime.Now.ToString(
                    "yyyy-MM-dd HH:mm:ss");

            string weightText =
                weight.ToString(
                    "0.00",
                    CultureInfo.InvariantCulture);

            DataGridViewRow existingRow;

            if (rowsById.TryGetValue(
                productId,
                out existingRow))
            {
                int inspectionCount = 0;

                object previousCount =
                    existingRow
                        .Cells["count"]
                        .Value;

                if (previousCount != null)
                {
                    int.TryParse(
                        previousCount.ToString(),
                        out inspectionCount);
                }

                inspectionCount++;

                existingRow.SetValues(
                    inspectionTime,
                    productId,
                    weightText,
                    result,
                    inspectionCount);

                existingRow.DefaultCellStyle.BackColor =
                    isOk
                        ? Color.FromArgb(232, 247, 238)
                        : Color.FromArgb(252, 235, 240);

                if (existingRow.Index > 0)
                {
                    dgvHistory.Rows.Remove(existingRow);
                    dgvHistory.Rows.Insert(0, existingRow);
                }

                rowsById[productId] =
                    existingRow;

                dgvHistory.ClearSelection();

                existingRow.Selected = true;
            }
            else
            {
                dgvHistory.Rows.Insert(
                    0,
                    inspectionTime,
                    productId,
                    weightText,
                    result,
                    1);

                DataGridViewRow newRow =
                    dgvHistory.Rows[0];

                newRow.DefaultCellStyle.BackColor =
                    isOk
                        ? Color.FromArgb(232, 247, 238)
                        : Color.FromArgb(252, 235, 240);

                rowsById[productId] =
                    newRow;

                dgvHistory.ClearSelection();

                newRow.Selected = true;
            }

            SaveAutomaticCsv(
                inspectionTime,
                productId,
                weightText,
                result);

            currentProductId = null;

            lblActiveId.Text =
                "ID aktif: -";

            txtScan.Clear();
            txtScan.Focus();
        }

        // =========================================================
        // CSV OTOMATIS
        // =========================================================

        private void SaveAutomaticCsv(
            string inspectionTime,
            string productId,
            string weight,
            string result)
        {
            try
            {
                bool newFile =
                    !File.Exists(automaticCsvPath);

                using (StreamWriter writer =
                    new StreamWriter(
                        automaticCsvPath,
                        true,
                        new UTF8Encoding(true)))
                {
                    if (newFile)
                    {
                        writer.WriteLine(
                            "Time,ProductID,Weight_kg,Result,Source");
                    }

                    string source =
                        simulationTimer.Enabled
                            ? "SIMULATION"
                            : "SCALE";

                    writer.WriteLine(
                        CsvValue(inspectionTime) + "," +
                        CsvValue(productId) + "," +
                        CsvValue(weight) + "," +
                        CsvValue(result) + "," +
                        CsvValue(source));
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gagal menyimpan CSV otomatis.\r\n\r\n" +
                    ex.Message,
                    "CSV Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

