        private void RefreshComPorts()
        {
            string previousPort = null;

            if (cmbPort != null &&
                cmbPort.SelectedItem != null)
            {
                previousPort =
                    cmbPort.SelectedItem.ToString();
            }

            cmbPort.Items.Clear();

            string[] ports =
                SerialPort.GetPortNames();

            Array.Sort(ports);

            cmbPort.Items.AddRange(ports);

            if (!string.IsNullOrWhiteSpace(previousPort) &&
                cmbPort.Items.Contains(previousPort))
            {
                cmbPort.SelectedItem =
                    previousPort;
            }
            else if (cmbPort.Items.Count > 0)
            {
                cmbPort.SelectedIndex = 0;
            }
        }

