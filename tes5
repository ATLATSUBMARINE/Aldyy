        private void UpdateHeaderClock()
        {
            if (lblHeaderDate == null ||
                lblHeaderTime == null)
            {
                return;
            }

            DateTime currentTime =
                DateTime.Now;

            CultureInfo culture =
                new CultureInfo("id-ID");

            lblHeaderDate.Text =
                currentTime.ToString(
                    "dddd, dd MMMM yyyy",
                    culture)
                .ToUpperInvariant();

            lblHeaderTime.Text =
                currentTime.ToString(
                    "HH:mm:ss");
        }

