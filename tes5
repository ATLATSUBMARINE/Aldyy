        // =========================================================
        // SERIAL DATA
        // =========================================================

        private void SerialPort_DataReceived(
            object sender,
            SerialDataReceivedEventArgs e)
        {
            try
            {
                if (serialPort == null ||
                    !serialPort.IsOpen)
                {
                    return;
                }

                string data =
                    serialPort.ReadExisting();

                if (string.IsNullOrEmpty(data))
                {
                    return;
                }

                BeginInvoke(
                    new Action(
                        delegate
                        {
                            ReceiveScaleData(data);
                        }));
            }
            catch (Exception ex)
            {
                try
                {
                    BeginInvoke(
                        new Action(
                            delegate
                            {
                                SetConnectionStatus(
                                    "● SERIAL ERROR",
                                    primaryColor);

                                txtRaw.AppendText(
                                    "Serial error: " +
                                    ex.Message +
                                    Environment.NewLine);
                            }));
                }
                catch
                {
                }
            }
        }

        private void ReceiveScaleData(string data)
        {
            string visibleData = data
                .Replace("\r", "\\r")
                .Replace("\n", "\\n\r\n");

            txtRaw.AppendText(visibleData);

            if (txtRaw.TextLength > 5000)
            {
                txtRaw.Text =
                    txtRaw.Text.Substring(
                        txtRaw.TextLength - 2500);

                txtRaw.SelectionStart =
                    txtRaw.TextLength;

                txtRaw.ScrollToCaret();
            }

            serialBuffer.Append(data);

            string fullData =
                serialBuffer.ToString();

            int separatorIndex;

            while ((separatorIndex =
                fullData.IndexOfAny(
                    new char[] { '\r', '\n' })) >= 0)
            {
                string line =
                    fullData.Substring(
                        0,
                        separatorIndex).Trim();

                fullData =
                    fullData.Substring(
                        separatorIndex + 1);

                if (!string.IsNullOrWhiteSpace(line))
                {
                    ParseScaleLine(line);
                }
            }

            serialBuffer.Clear();
            serialBuffer.Append(fullData);

            if (serialBuffer.Length > 500)
            {
                serialBuffer.Clear();
            }
        }

        // =========================================================
        // PARSING DATA TIMBANGAN
        // =========================================================

        private void ParseScaleLine(string line)
        {
            Match numberMatch =
                Regex.Match(
                    line,
                    @"[-+]?\d+(?:[.,]\d+)?");

            if (!numberMatch.Success)
            {
                lblStable.Text =
                    "DATA TIDAK VALID";

                lblStable.ForeColor =
                    primaryColor;

                return;
            }

            string weightText =
                numberMatch.Value.Replace(',', '.');

            double weight;

            bool parsed =
                double.TryParse(
                    weightText,
                    NumberStyles.Float,
                    CultureInfo.InvariantCulture,
                    out weight);

            if (!parsed)
            {
                lblStable.Text =
                    "DATA TIDAK VALID";

                lblStable.ForeColor =
                    primaryColor;

                return;
            }

            string upperLine =
                line.ToUpperInvariant();

            bool containsKg =
                upperLine.Contains("KG");

            bool containsGram =
                Regex.IsMatch(
                    upperLine,
                    @"\d(?:[.,]\d+)?\s*G\b");

            if (!containsKg && containsGram)
            {
                weight /= 1000.0;
            }

            if (weight < 0)
            {
                weight = 0;
            }

            ProcessWeight(weight);
        }

        // =========================================================
        // PROSES BERAT
        // =========================================================

        private void ProcessWeight(double weight)
        {
            lblWeight.Text =
                weight.ToString(
                    "0.00",
                    CultureInfo.InvariantCulture) +
                " kg";

            if (weight < EmptyThreshold)
            {
                readyToRecord = true;
                stableCount = 0;
                lastWeight = double.NaN;

                lblStable.Text = "KOSONG";
                lblStable.ForeColor =
                    secondaryTextColor;

                if (currentProductId == null)
                {
                    SetResult(
                        "WAITING",
                        Color.FromArgb(230, 231, 234),
                        mainTextColor);
                }
                else
                {
                    SetResult(
                        "TARUH PRODUK",
                        Color.FromArgb(246, 220, 228),
                        primaryColor);
                }

                return;
            }

            if (!double.IsNaN(lastWeight) &&
                Math.Abs(weight - lastWeight) <=
                StableTolerance)
            {
                stableCount++;
            }
            else
            {
                stableCount = 0;
            }

            lastWeight = weight;

            bool isStable =
                stableCount >= StableRequired;

            lblStable.Text =
                isStable
                    ? "STABLE"
                    : "UNSTABLE";

            lblStable.ForeColor =
                isStable
                    ? okColor
                    : warningColor;

            if (!isStable ||
                !readyToRecord)
            {
                return;
            }

            if (currentProductId == null)
            {
                SetResult(
                    "SCAN ID DULU",
                    Color.FromArgb(255, 235, 185),
                    Color.FromArgb(110, 70, 0));

                return;
            }

            readyToRecord = false;

            RecordInspection(
                currentProductId,
                weight);
        }

