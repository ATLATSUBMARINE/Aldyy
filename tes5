        // =========================================================
        // EXPORT CSV
        // =========================================================

        private void BtnExport_Click(
            object sender,
            EventArgs e)
        {
            if (dgvHistory.Rows.Count == 0)
            {
                MessageBox.Show(
                    "Belum ada data yang dapat diekspor.",
                    "Export CSV",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information);

                txtScan.Focus();

                return;
            }

            using (SaveFileDialog dialog =
                new SaveFileDialog())
            {
                dialog.Title =
                    "Export Data Pemeriksaan";

                dialog.Filter =
                    "CSV File (*.csv)|*.csv";

                dialog.DefaultExt =
                    "csv";

                dialog.AddExtension =
                    true;

                dialog.FileName =
                    "Weight_Checker_" +
                    DateTime.Now.ToString(
                        "yyyyMMdd_HHmmss") +
                    ".csv";

                if (dialog.ShowDialog() !=
                    DialogResult.OK)
                {
                    txtScan.Focus();
                    return;
                }

                try
                {
                    using (StreamWriter writer =
                        new StreamWriter(
                            dialog.FileName,
                            false,
                            new UTF8Encoding(true)))
                    {
                        writer.WriteLine(
                            "Waktu,Product ID,Berat (kg),Hasil,Jumlah Cek");

                        foreach (
                            DataGridViewRow row
                            in dgvHistory.Rows)
                        {
                            if (row.IsNewRow)
                            {
                                continue;
                            }

                            string time =
                                CsvValue(
                                    row.Cells["time"].Value);

                            string id =
                                CsvValue(
                                    row.Cells["id"].Value);

                            string weight =
                                CsvValue(
                                    row.Cells["weight"].Value);

                            string result =
                                CsvValue(
                                    row.Cells["result"].Value);

                            string count =
                                CsvValue(
                                    row.Cells["count"].Value);

                            writer.WriteLine(
                                time + "," +
                                id + "," +
                                weight + "," +
                                result + "," +
                                count);
                        }
                    }

                    MessageBox.Show(
                        "Data berhasil diekspor ke:\r\n\r\n" +
                        dialog.FileName,
                        "Export Berhasil",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);
                }
                catch (Exception ex)
                {
                    MessageBox.Show(
                        "Gagal export CSV.\r\n\r\n" +
                        ex.Message,
                        "Export Error",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error);
                }
            }

            txtScan.Focus();
        }

        // =========================================================
        // FORMAT CSV
        // =========================================================

        private string CsvValue(object value)
        {
            string text =
                value == null
                    ? string.Empty
                    : value.ToString();

            if (text.Contains(",") ||
                text.Contains("\"") ||
                text.Contains("\r") ||
                text.Contains("\n"))
            {
                text =
                    "\"" +
                    text.Replace(
                        "\"",
                        "\"\"") +
                    "\"";
            }

            return text;
        }
    }
