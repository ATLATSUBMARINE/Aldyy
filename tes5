        private Control CreateLogoPanel()
        {
            Panel logoPanel = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = Color.White,
                Padding = new Padding(12, 10, 12, 10),
                Margin = Padding.Empty
            };

            PictureBox pictureLogo = new PictureBox
            {
                Dock = DockStyle.Fill,
                BackColor = Color.White,
                SizeMode = PictureBoxSizeMode.Zoom,
                Margin = Padding.Empty
            };

            string applicationFolder =
                AppDomain.CurrentDomain.BaseDirectory;

            string[] possibleLogoNames =
            {
                "lg.innotek_logo_png.jpg",
                "lg.innotek_logo_png.jpeg",
                "lg.innotek_logo_png.png",
                "lg.innotek_logo.jpg",
                "lg.innotek_logo.jpeg",
                "lg.innotek_logo.png",
                "lg_innotek_logo.jpg",
                "lg_innotek_logo.jpeg",
                "lg_innotek_logo.png",
                "LG_Innotek_Logo.jpg",
                "LG_Innotek_Logo.jpeg",
                "LG_Innotek_Logo.png"
            };

            string logoPath = null;

            foreach (string logoName in possibleLogoNames)
            {
                string candidatePath =
                    Path.Combine(
                        applicationFolder,
                        logoName);

                if (File.Exists(candidatePath))
                {
                    logoPath = candidatePath;
                    break;
                }
            }

            if (string.IsNullOrEmpty(logoPath))
            {
                try
                {
                    string[] files =
                        Directory.GetFiles(
                            applicationFolder);

                    foreach (string file in files)
                    {
                        string extension =
                            Path.GetExtension(file)
                                .ToLowerInvariant();

                        bool supported =
                            extension == ".jpg" ||
                            extension == ".jpeg" ||
                            extension == ".png" ||
                            extension == ".bmp";

                        if (!supported)
                        {
                            continue;
                        }

                        string fileName =
                            Path.GetFileNameWithoutExtension(file)
                                .ToLowerInvariant();

                        if (fileName.Contains("innotek") ||
                            fileName.Contains("lg"))
                        {
                            logoPath = file;
                            break;
                        }
                    }
                }
                catch
                {
                    logoPath = null;
                }
            }

            if (!string.IsNullOrEmpty(logoPath))
            {
                try
                {
                    using (Image temporaryImage =
                        Image.FromFile(logoPath))
                    {
                        pictureLogo.Image =
                            new Bitmap(temporaryImage);
                    }
                }
                catch
                {
                    pictureLogo.Image = null;
                }
            }

            if (pictureLogo.Image != null)
            {
                logoPanel.Controls.Add(
                    pictureLogo);
            }
            else
            {
                Label fallbackLabel = new Label
                {
                    Text = "LG Innotek",
                    Dock = DockStyle.Fill,
                    TextAlign =
                        ContentAlignment.MiddleCenter,
                    ForeColor = primaryColor,
                    BackColor = Color.White,
                    Font = new Font(
                        "Segoe UI",
                        15F,
                        FontStyle.Bold)
                };

                logoPanel.Controls.Add(
                    fallbackLabel);
            }

            return logoPanel;
        }

