        // =========================================================
        // SIMULASI
        // =========================================================

        private void SimulationTimer_Tick(
            object sender,
            EventArgs e)
        {
            simulationTick++;

            int phase =
                simulationTick % 80;

            double weight;

            if (phase < 10)
            {
                weight =
                    random.NextDouble() *
                    0.03;
            }
            else if (phase < 25)
            {
                double progress =
                    (phase - 10) /
                    15.0;

                weight =
                    simulationTarget *
                    progress;

                weight +=
                    (random.NextDouble() - 0.5) *
                    0.10;
            }
            else if (phase < 55)
            {
                weight =
                    simulationTarget;
            }
            else if (phase < 65)
            {
                double progress =
                    (phase - 55) /
                    10.0;

                weight =
                    simulationTarget *
                    (1.0 - progress);

                weight +=
                    (random.NextDouble() - 0.5) *
                    0.05;
            }
            else
            {
                weight =
                    random.NextDouble() *
                    0.03;
            }

            if (weight < 0)
            {
                weight = 0;
            }

            ProcessWeight(weight);

            if (phase == 79)
            {
                CreateNextSimulationWeight();
            }
        }

        private void CreateNextSimulationWeight()
        {
            double lower =
                (double)numLower.Value;

            double target =
                (double)numTarget.Value;

            double upper =
                (double)numUpper.Value;

            if (lower >= upper)
            {
                simulationTarget = target;
                return;
            }

            int resultType =
                random.Next(0, 10);

            if (resultType < 7)
            {
                simulationTarget =
                    lower +
                    random.NextDouble() *
                    (upper - lower);
            }
            else if (resultType < 9)
            {
                simulationTarget =
                    Math.Max(
                        0,
                        lower -
                        0.10 -
                        random.NextDouble() *
                        0.30);
            }
            else
            {
                simulationTarget =
                    upper +
                    0.10 +
                    random.NextDouble() *
                    0.30;
            }

            simulationTarget =
                Math.Round(
                    simulationTarget,
                    2);
        }

